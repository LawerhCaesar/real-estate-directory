# Serverless SQLite. Vercel's Turso integration supplies these in production.
TURSO_DATABASE_URL=file:./data/hotwaves.db
TURSO_AUTH_TOKEN=

# Sign in with Vercel app credentials.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Exactly the team members allowed to add or edit listings.
ADMIN_EMAILS=member-one@example.com,member-two@example.com,member-three@example.com

# Optional local-only identity when OAuth has not been configured.
DEV_ADMIN_EMAIL=member-one@example.com

# Canonical production origin, used by social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
