# Serverless SQLite. Vercel's Turso integration supplies these in production.
TURSO_DATABASE_URL=file:./data/hotwaves.db
TURSO_AUTH_TOKEN=

# One shared team login. Store the hash and session secret as Vercel secrets.
ADMIN_USERNAME=hotwaves-team
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Canonical production origin, used by social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
